#EXT-X-VERSION:6
# ===== PHỤ ĐỀ (SUBTITLES) =====
# Mỗi dòng là 1 phụ đề, đổi URI thành link file .vtt của bạn
#EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID="subs",NAME="Tiếng Việt",LANGUAGE="vi",DEFAULT=YES,AUTOSELECT=YES,FORCED=NO,URI="https://vicdn.cc/subtitle/l4n4z334z224y233v2q274o25334z5a4.html"
